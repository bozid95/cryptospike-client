# CryptoSpike Client - Server Local Environment Template
PORT=3030
SERVER_URL=https://signal.forlearning.my.id
CLIENT_TOKEN=

# Binance Trailing Stop (Hybrid Runner) Configuration
BINANCE_TRAILING_CALLBACK=2.5
BINANCE_TRAILING_ACTIVATION=TP1
BINANCE_AUTO_BEP=true
BINANCE_BEP_BUFFER_PCT=0.2
# Skip a signal when the mark price deviates more than N x SL distance from the signal entry
BINANCE_MAX_ENTRY_DEVIATION_R=0.5
# RISK_AT_SL sizing: minimum SL distance (%) and maximum margin per trade (% of balance)
BINANCE_RISK_MIN_SL_PCT=0.5
BINANCE_RISK_MAX_MARGIN_PCT=20

