generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 1. Pengaturan Utama Bot & Lisensi Client (Global Single-row)
model AppConfig {
  id             Int      @id @default(1)
  targetExchange String   @default("BINANCE") // "BINANCE", "TOKOCRYPTO", atau "BOTH"
  clientToken    String?  // Token lisensi langganan dari Server Utama CryptoSpike
  updatedAt      DateTime @updatedAt
}

// 2. Konfigurasi Mandiri Binance Futures (Single-row)
model BinanceConfig {
  id                    Int      @id @default(1)

  // 🧪 KONFIGURASI MANDIRI BINANCE TESTNET (DEMO)
  testnetApiKey               String?  // API Key Binance Testnet
  testnetApiSecret            String?  // API Secret Binance Testnet
  testnetAutoExecute          Boolean  @default(false)
  testnetTradeDirection       String   @default("BOTH")       // "BOTH", "LONG_ONLY", "SHORT_ONLY"
  testnetMinScore             Int      @default(0)            // Ambang batas skor (0 - 100)
  testnetBlockLongOnBtcBearish Boolean @default(true)         // Proteksi tren makro BTC
  testnetLeverage             Int      @default(10)           // Leverage 1x - 125x
  testnetMarginType           String   @default("ISOLATED")   // ISOLATED atau CROSSED
  testnetRiskPerTradePct      Float    @default(2.0)          // Risiko per trade (%)
  testnetMaxOpenPositions     Int      @default(3)            // Maksimal posisi terbuka
  testnetCoinFilterMode       String   @default("ALL")        // ALL, WHITELIST, BLACKLIST
  testnetTargetCoins          String?  @default("")           // Daftar koin target

  // 🚀 KONFIGURASI MANDIRI BINANCE LIVE (RIIL)
  liveApiKey                  String?  // API Key Binance Live
  liveApiSecret               String?  // API Secret Binance Live
  liveAutoExecute             Boolean  @default(false)
  liveTradeDirection          String   @default("BOTH")       // "BOTH", "LONG_ONLY", "SHORT_ONLY"
  liveMinScore                Int      @default(0)            // Ambang batas skor (0 - 100)
  liveBlockLongOnBtcBearish   Boolean  @default(true)         // Proteksi tren makro BTC
  liveLeverage                Int      @default(10)           // Leverage 1x - 125x
  liveMarginType              String   @default("ISOLATED")   // ISOLATED atau CROSSED
  liveRiskPerTradePct         Float    @default(2.0)          // Risiko per trade (%)
  liveMaxOpenPositions        Int      @default(3)            // Maksimal posisi terbuka
  liveCoinFilterMode          String   @default("ALL")        // ALL, WHITELIST, BLACKLIST
  liveTargetCoins             String?  @default("")           // Daftar koin target

  // 🔄 KOLOM LEGACY (Kompatibilitas & Fallback)
  apiKey                String?  // API Key Binance Legacy
  apiSecret             String?  // API Secret Binance Legacy
  environment           String   @default("TESTNET") // TESTNET atau LIVE
  autoExecute           Boolean  @default(false)
  tradeDirection        String   @default("BOTH")
  minScore              Int      @default(0)
  blockLongOnBtcBearish Boolean  @default(true)
  leverage              Int      @default(10)
  marginType            String   @default("ISOLATED")
  riskPerTradePct       Float    @default(2.0)
  maxOpenPositions      Int      @default(3)
  coinFilterMode        String   @default("ALL")
  targetCoins           String?  @default("")
  updatedAt             DateTime @updatedAt
}

// 3. Konfigurasi Mandiri Tokocrypto Spot (Single-row)
model TokocryptoConfig {
  id               Int      @id @default(1)
  apiKey           String?  // API Key Tokocrypto
  apiSecret        String?  // API Secret Tokocrypto
  quoteAsset       String   @default("USDT") // "USDT" atau "BIDR"
  autoExecute      Boolean  @default(false)
  dryRun           Boolean  @default(false) // Mode simulasi tanpa uang riil
  riskPerTradePct  Float    @default(10.0)
  maxOpenPositions Int      @default(5)
  coinFilterMode   String   @default("ALL") // ALL, WHITELIST, atau BLACKLIST
  targetCoins      String?  @default("")
  updatedAt        DateTime @updatedAt
}

// Akun Pengguna / Admin Aplikasi Lokal
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Catatan Posisi Beli Koin Tokocrypto (Spot) Secara Lokal
model SpotTrade {
  id           String    @id @default(uuid())
  exchange     String    @default("TOKOCRYPTO")
  symbol       String    // Contoh: "BTC_USDT"
  buyOrderId   String
  entryPrice   Float
  quantity     Float
  remainingQty Float?    // Sisa koin yang belum terjual
  tp1Price     Float?
  tp2Price     Float?
  tp3Price     Float?
  tp1Qty       Float?    // Alokasi kuantitas untuk TP1 (50% / merged)
  tp2Qty       Float?    // Alokasi kuantitas untuk TP2 (30% / merged)
  tp3Qty       Float?    // Alokasi kuantitas untuk TP3 (20% / merged)
  tpStage      Int       @default(0) // 0 = belum TP, 1 = TP1 hit, 2 = TP2 hit, 3 = Full TP
  realizedPnl  Float     @default(0) // Akumulasi profit terkunci (USD)
  tpPrice      Float     // Target fallback / backward compatibility
  slPrice      Float     // Entry - 2.5%
  status       String    @default("OPEN") // "OPEN", "TP_CLOSED", "SL_CLOSED", "MANUAL_CLOSED"
  exitPrice    Float?
  exitOrderId  String?
  pnlUsd       Float?
  createdAt    DateTime  @default(now())
  closedAt     DateTime?
}

