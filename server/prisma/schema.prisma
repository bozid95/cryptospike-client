generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Pengaturan Utama Bot & Kredensial (Single-row config)
model AppConfig {
  id                      Int      @id @default(1)
  
  // Pilihan Bursa Utama Aktif
  targetExchange          String   @default("BINANCE") // "BINANCE", "TOKOCRYPTO", atau "BOTH"

  // Kredensial & Lisensi Utama CryptoSpike
  clientToken             String?  // Token langganan dari Server Utama CryptoSpike

  // --- Binance Futures Dedicated Config ---
  binanceApiKey           String?  // API Key Binance
  binanceApiSecret        String?  // API Secret Binance
  environment             String   @default("TESTNET") // TESTNET atau LIVE
  binanceAutoExecute      Boolean  @default(false)
  leverage                Int      @default(10)
  marginType              String   @default("ISOLATED") // ISOLATED atau CROSSED
  binanceRiskPerTradePct  Float    @default(2.0)
  binanceMaxOpenPositions Int      @default(3)
  binanceCoinFilterMode   String   @default("ALL") // ALL, WHITELIST, atau BLACKLIST
  binanceTargetCoins      String?  @default("")

  // --- Tokocrypto Spot Dedicated Config ---
  tokocryptoApiKey           String?  // API Key Tokocrypto
  tokocryptoApiSecret        String?  // API Secret Tokocrypto
  tokocryptoQuoteAsset       String   @default("USDT") // "USDT" atau "BIDR"
  tokocryptoAutoExecute      Boolean  @default(false)
  tokocryptoDryRun           Boolean  @default(false) // Mode simulasi tanpa uang riil
  tokocryptoRiskPerTradePct  Float    @default(10.0)
  tokocryptoMaxOpenPositions Int      @default(5)
  tokocryptoCoinFilterMode   String   @default("ALL")
  tokocryptoTargetCoins      String?  @default("")

  // Legacy fallback fields (kompatibilitas query lama & test mocks)
  autoExecute             Boolean  @default(false)
  dryRun                  Boolean  @default(false)
  riskPerTradePct         Float    @default(2.0)
  maxOpenPositions        Int      @default(3)
  coinFilterMode          String   @default("ALL")
  targetCoins             String?  @default("")

  updatedAt               DateTime @updatedAt
}

// Akun Pengguna / Admin Aplikasi Lokal
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Catatan Posisi Beli Koin Tokocrypto (Spot) Secara Lokal
model SpotTrade {
  id          String    @id @default(uuid())
  exchange    String    @default("TOKOCRYPTO")
  symbol      String    // Contoh: "BTC_USDT"
  buyOrderId  String
  entryPrice  Float
  quantity    Float
  tpPrice     Float     // Entry + 5%
  slPrice     Float     // Entry - 2.5%
  status      String    @default("OPEN") // "OPEN", "TP_CLOSED", "SL_CLOSED", "MANUAL_CLOSED"
  exitPrice   Float?
  exitOrderId String?
  pnlUsd      Float?
  createdAt   DateTime  @default(now())
  closedAt    DateTime?
}

