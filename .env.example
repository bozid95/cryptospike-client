# ========================================================
# CryptoSpike Client - Environment Configuration Template
# ========================================================

# Port Web Dashboard (Default: 3080)
PORT=3080

# URL Server Sinyal CryptoSpike
SERVER_URL=https://signal.forlearning.my.id

# (Opsional) Token Lisensi Klien (Bisa juga diisi via Web Dashboard)
CLIENT_TOKEN=

# Binance Trailing Stop (Hybrid Runner) Configuration
BINANCE_TRAILING_CALLBACK=2.5
BINANCE_TRAILING_ACTIVATION=TP1
BINANCE_AUTO_BEP=true
BINANCE_BEP_BUFFER_PCT=0.2
